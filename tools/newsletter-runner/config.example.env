# Copy to .env and fill in values (KA Inventory spreadsheet)

GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_CREDENTIALS_JSON=/path/to/kommu-newsletter.json
NEWSLETTER_SHEET_TAB=Newsletter
ORDERS_SHEET_TAB=Orders

# Subscribe API (Tailscale Funnel exposes SUBSCRIBE_API_PORT)
SUBSCRIBE_API_HOST=127.0.0.1
SUBSCRIBE_API_PORT=8788
NEWSLETTER_CORS_ORIGINS=https://kommu.ai,https://www.kommu.ai,https://alexanderyeohsx.github.io

SMTP_HOST=smtp.migadu.com
SMTP_PORT=465
SMTP_TLS=true
SMTP_USER=newsletter@kommu.ai
SMTP_PASSWORD=your_smtp_password
MAIL_FROM="Kommu <newsletter@kommu.ai>"

MAX_SENDS_PER_RUN=50
# Migadu Mini is 100 outbound/day for the whole account.
MAX_SENDS_PER_DAY=100

# Unsubscribe links → same Apps Script /exec URL as site newsletter_api_url
NEWSLETTER_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
# CTA click tracking page (logs to Apps Script, then redirects). Default: https://kommu.ai/go/
# NEWSLETTER_CLICK_REDIRECT_URL=https://kommu.ai/go/
UNSUBSCRIBE_SECRET=generate_a_long_random_secret

# Testing only: send steps 2+ this many minutes after the previous email (unset for production delays).
# NEWSLETTER_TEST_INTERVAL_MINUTES=1
